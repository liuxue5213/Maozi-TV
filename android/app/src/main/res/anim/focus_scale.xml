<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点移到卡片时的缩放+发光动画 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200">
    <scale
        android:fromXScale="1.0"
        android:toXScale="1.06"
        android:fromYScale="1.0"
        android:toYScale="1.06"
        android:pivotX="50%"
        android:pivotY="50%" />
</set>
