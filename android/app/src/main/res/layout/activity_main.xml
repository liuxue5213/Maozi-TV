<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 视频播放区 -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <!-- 当前频道 OSD（增强：EPG + 码率 + 分辨率 + 信号格） -->
        <LinearLayout
            android:id="@+id/channel_info_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_osd_panel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- 频道名 + 频道号 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_channel_num_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#4A9EFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- EPG 当前节目 -->
            <TextView
                android:id="@+id/tv_epg_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 分组 -->
            <TextView
                android:id="@+id/tv_channel_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <!-- 画质/码率/分辨率 信息行 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9090A0"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tv_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#9090A0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 信号强度指示器 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:id="@+id/signal_bars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    <View android:id="@+id/sig_bar1" android:layout_width="3dp" android:layout_height="4dp" android:layout_marginEnd="1dp" android:background="#33FFFFFF" />
                    <View android:id="@+id/sig_bar2" android:layout_width="3dp" android:layout_height="7dp" android:layout_marginEnd="1dp" android:background="#33FFFFFF" />
                    <View android:id="@+id/sig_bar3" android:layout_width="3dp" android:layout_height="10dp" android:layout_marginEnd="1dp" android:background="#33FFFFFF" />
                    <View android:id="@+id/sig_bar4" android:layout_width="3dp" android:layout_height="13dp" android:background="#33FFFFFF" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_signal_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#9090A0"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/bg_osd_panel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="0 KB/s" />

        <TextView
            android:id="@+id/tv_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="96sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12"
            android:visibility="gone" />

        <!-- 状态/错误提示（增强：文字 + 重试按钮） -->
        <LinearLayout
            android:id="@+id/tv_status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_osd_panel"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:text="重试"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_search_input"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 全屏选台面板 -->
    <FrameLayout
        android:id="@+id/channel_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6101018"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 顶栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="#CC141420">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎩 选台"
                    android:textColor="#4A9EFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="搜索频道..."
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/tv_panel_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#9090A0"
                    android:textSize="13sp"
                    android:text="0 个频道" />
            </LinearLayout>

            <!-- 主体：分类 + 网格 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_categories"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:background="#141420"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#22FFFFFF" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_channels"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- 底栏提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="OK 确认 · 长按收藏 · 返回关闭 · 上下键换台"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                android:background="#0A0A12" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
