<?xml version="1.0" encoding="utf-8"?>
<!-- 设置中心：左侧分类导航 + 右侧设置项列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#141420">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 设置"
            android:textColor="#4A9EFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="遥控器: 上/下选择 · OK/Enter 确认 · 返回退出"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 主体：分类 + 设置列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧分类导航 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_settings_categories"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="#101018"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#22FFFFFF" />

        <!-- 右侧设置项列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_settings_items"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
