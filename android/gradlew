##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#       (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#           noncompliant, but you have some other compliant shell such as ksh or
#           bash, then to run this script, type that shell name before the whole
#           command line, like:
#
#               ksh Gradle
#
#           Busybox and similar reduced shells will NOT work, because this script
#           requires all of these POSIX shell features:
#             * functions;
#             * expansions «$var», «${var}», «${var:-default}», «${var+SET}»,
#               «${var#prefix}», «${var%suffix}», and «$( cmd )»;
#             * compound commands having a testable exit status, especially «case»;
#             * various built-in commands including «command», «set», and «ulimit».
#
#           Important for patching:
#
#           (2) This script targets POSIX compliant shells. For shells that have
#               non-POSIX compatible extensions, the script may not work as
#               intended. The script can be patched for specific shells.
#
#               The following are known to have non-POSIX compatible behavior and
#               should be avoided if the intend is to run the script unmodified:
#                 * dash
#                 * zsh (when in sh mode)
#                 * ash
#                 * yash
#
#           For patching these shells, you can use the following shell script:
#               https://github.com/gradle/gradle/blob/master/platform/jvm/pruning.sh
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
# Discard cd standard output in case $CDPATH is set (https://github.com/gradle/gradle/issues/25036)
APP_HOME=$( cd -P -- "$( dirname -- "$0" )" && printf '%s
' "$PWD" ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true  ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * --module-path (only if needed)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variables.

# For Cygwin or MSYS, switch paths to Windows format before running java
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # Now convert the arguments - kludge to limit ourselves to /bin/sh
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # don't mess with options #(
              /?*)  t=${arg#/} t=/${t%%/*}              # looks like a POSIX filepath
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" )
        fi
        # Roll the args around into the expected order
        shift                   # remove old arg
        set -- "$@" "$arg"     # push replacement arg
    done
fi


# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

# Collect all arguments for the java command:
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, JAVA_OPTS, and optsEnvironmentVar are not allowed to contain shell fragments,
#     and any embedded shellness will be escaped.
#   * For example: A user cannot expect ${HOME} to be expanded, as it is an environment variable and will be treated as
#     ${HOME} (i.e., as an environment variable within the shell), not the Bash expansion $HOME.
#   * For example: A user cannot expect echo "${HOME}" to be escaped as ${HOME}. Instead, it will be escaped as \${HOME}
#     to retain the literal text ${HOME}, and then the shell will expand the ${HOME} environment variable if present.
#     However, this does not happen on Windows because there is no shell that expands ${HOME}, so the argument is kept as is.
#   * Any variable expansion in the command line will be performed by the shell, so if there is a variable that needs to be
#     expanded by the Java program, it must be escaped as \\${HOME}
#   * The only way to pass arguments that contain shell metacharacters is to escape them, either with single quotes
#   or with backslashes. For example: a user cannot pass ${HOME} as an argument, because it will be expanded by the shell.
#     Instead, they can pass '${HOME}' or "\${HOME}", but not '${HOME}' or "${HOME}".
#     For Windows, the shell is different, and the expansion behavior is also different. For example, %USERPROFILE% is expanded
#     by the shell, but ${HOME} is not. So a user can pass ${HOME} as an argument, and it will be kept as ${HOME}.
# * For Cygwin and MSYS, the path conversion is performed, and the shell metacharacters are escaped.
#     For example, a user can pass ${HOME} as an argument, and it will be escaped as \${HOME} and converted to %USERPROFILE% by the shell.
# * For non-Cygwin/MSYS Windows, the shell metacharacters are escaped, but the path conversion is not performed.
#     For example, a user can pass ${HOME} as an argument, and it will be escaped as \${HOME}, but the shell will not expand it.

APP_NAME="Gradle"
APP_BASE_NAME=$0

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum


# Add constants for tools that are not available on all operating systems.
if [ "$darwin" = "true" ] ; then
    # Darwin doesn't support GNU readlink, so use greadlink if available
    if command -v greadlink >/dev/null 2>&1 ; then
        READLINK=greadlink
    else
        READLINK=readlink
    fi
else
    READLINK=readlink
fi

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# Define a few common escape sequences for escaping shell metacharacters.
ESCAPE_SEQUENCE_SINGLE_QUOTE='\''
ESCAPE_SEQUENCE_DOUBLE_QUOTE='\"'
ESCAPE_SEQUENCE_BACKSLASH='\\'
ESCAPE_SEQUENCE_NEWLINE='$\n'
ESCAPE_SEQUENCE_CARRIAGE_RETURN='$\r'
ESCAPE_SEQUENCE_TAB='$\t'
ESCAPE_SEQUENCE_DOLLAR_SIGN='$\$'
ESCAPE_SEQUENCE_BACKTICK='\`'

# Escape shell metacharacters in the argument.
escape_shell_argument () {
    local argument=$1
    local result=""
    local char=
    local i=0
    local length=${#argument}

    for ((i=0; i<length; i++)) ; do
        char=${argument:i:1}
        case $char in
            $ESCAPE_SEQUENCE_SINGLE_QUOTE)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_SINGLE_QUOTE"
                ;;
            $ESCAPE_SEQUENCE_DOUBLE_QUOTE)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_DOUBLE_QUOTE"
                ;;
            $ESCAPE_SEQUENCE_BACKSLASH)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_BACKSLASH"
                ;;
            $ESCAPE_SEQUENCE_NEWLINE)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_NEWLINE"
                ;;
            $ESCAPE_SEQUENCE_CARRIAGE_RETURN)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_CARRIAGE_RETURN"
                ;;
            $ESCAPE_SEQUENCE_TAB)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_TAB"
                ;;
            $ESCAPE_SEQUENCE_DOLLAR_SIGN)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_DOLLAR_SIGN"
                ;;
            $ESCAPE_SEQUENCE_BACKTICK)
                result="$result$ESCAPE_SEQUENCE_BACKSLASH$ESCAPE_SEQUENCE_BACKTICK"
                ;;
            *)
                result="$result$char"
                ;;
        esac
    done

    echo "$result"
}

# Escape arguments for use inside the double quotes that will be used to form the Java command line.
escape_arguments () {
    local result=""
    for arg in "$@" ; do
        local escaped_arg
        escaped_arg=$(escape_shell_argument "$arg")
        result="$result \"$escaped_arg\""
    done
    echo "$result"
}

# Escape arguments for use inside the backticks that will be used to form the eval string for the Java command line.
escape_arguments_backticks () {
    local result=""
    for arg in "$@" ; do
        local escaped_arg
        escaped_arg=$(escape_shell_argument "$arg")
        result="$result '$escaped_arg'"
    done
    echo "$result"
}

# Escape all the metacharacters in the specified argument, and then prepend the specified escape sequence.
escape_and_prepend () {
    local argument=$1
    local escape_sequence=$2
    local escaped_argument
    escaped_argument=$(escape_shell_argument "$argument")
    echo "$escape_sequence$escaped_argument"
}

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

# Collect all arguments for the java command
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when no more arguments should be processed (no more $*)
# Stop when no more expansion should be done (no more ${var})
# Stop when no more command substitution should be done (no more $(cmd))
# Stop when no more arithmetic expansion should be done (no more $((expr)))
# Stop when no more tilde expansion should be done (no more ~user)
# Stop when no more parameter expansion should be done (no more ${param:-word})
# Stop when no more pattern substitution should be done (no more ${param%pattern})
# Stop when no more command grouping should be done (no more { cmd1; cmd2; })
# Stop when no more subshell execution should be done (no more $(cmd))
# Stop when no more pipe creation should be done (no more | cmd)
# Stop when no more background process execution should be done (no more cmd &)
# Stop when no more logical AND should be done (no more && cmd)
# Stop when no more logical OR should be done (no more || cmd)
# Stop when no more logical NOT should be done (no more ! cmd)
# Stop when no more conditional execution should be done (no more if/then/else/fi)
# Stop when no more case execution should be done (no more case/esac)
# Stop when no more for execution should be done (no more for/do/done)
# Stop when no more while execution should be done (no more while/do/done)
# Stop when no more until execution should be done (no more until/do/done)
# Stop when no more function execution should be done (no more function())
# Stop when no more alias expansion should be done (no more alias)
# Stop when no more glob expansion should be done (no more *)
# Stop when no more brace expansion should be done (no more {a,b,c})
# Stop when no more arithmetic expansion should be done (no more $((expr)))
# Stop when no more command substitution should be done (no more $(cmd))
# Stop when no more process substitution should be done (no more <(cmd))
# Stop when no more pipeline should be done (no more | cmd)

exec "$JAVACMD" "$@"
